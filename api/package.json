{
  "name": "fidc-onboarding-cedente-api",
  "version": "1.0.0",
  "private": true,
  "description": "Mock da API de remessa de recebíveis do FIDC simulado",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:architecture": "depcruise src --config .dependency-cruiser.cjs",
    "lint:openapi": "redocly lint openapi.yaml",
    "test": "jest",
    "check": "npm run -s lint && npm run -s typecheck && npm run -s lint:architecture && npm run -s test -- --silent && npm run -s lint:openapi"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@nestjs/testing": "11.1.6",
    "@redocly/cli": "1.34.3",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "dependency-cruiser": "17.0.1",
    "eslint": "9.34.0",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "js-yaml": "4.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1"
  }
}
